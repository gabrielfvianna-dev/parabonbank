# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo .env NÃO vai para o Git (já está no .gitignore da raiz).

# Porta da API
PORT=3000

# Conexão com o MySQL (banco criado pelo script sistema_bancario)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=sistema_bancario

# Agência onde as novas contas são abertas (dados iniciais do banco)
BANCO_CODIGO=999
AGENCIA_CODIGO=0001

# Segurança
# Custo do bcrypt (12 = mesmo custo dos hashes de exemplo do banco)
BCRYPT_CUSTO=12
# Validade da sessão de login, em minutos
SESSAO_MINUTOS=480
# Tentativas de senha errada antes de bloquear e por quantos minutos bloqueia
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Limite de requisições nas rotas de login/cadastro por IP a cada 15 minutos
RATE_LIMIT_AUTH_MAX=20
# Limite de envios de Pix por IP a cada minuto
RATE_LIMIT_PIX_MAX=30
# Valor máximo de um único Pix (R$)
PIX_LIMITE_POR_TRANSACAO=10000

# Origens que podem chamar a API pelo navegador (Expo web). Separe por vírgula.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Rotas de desenvolvimento (depósito de teste). NUNCA deixe "true" em produção.
HABILITAR_ROTAS_DEV=false
